DATABASE_URL=postgresql+asyncpg://campfire:campfire@localhost:5432/campfire
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
CORS_ORIGINS=http://localhost:5173
GOOGLE_STUB_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
WEB_BASE_URL=http://localhost:5173
OAUTH_FLOW_HMAC_KEY=
OAUTH_FLOW_TTL_SECONDS=600
EMAIL_CONFIRMATION_REQUIRED=true
EMAIL_CONFIRMATION_HMAC_KEY=
EMAIL_CONFIRMATION_TTL_SECONDS=900
EMAIL_CONFIRMATION_MAX_ATTEMPTS=5
EMAIL_CONFIRMATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_CONFIRMATION_RESEND_HOURLY_CAP=3
# MAIL_BACKEND=console writes confirmation codes to MAIL_OUTBOX_DIR (default
# tmp/mail/) instead of sending real email. In local development, inspect the
# latest *-confirmation.txt file in that directory to retrieve the 6-digit
# code. Set MAIL_BACKEND=http with MAIL_HTTP_URL/MAIL_HTTP_API_KEY to enable
# real delivery via a transactional provider.
MAIL_BACKEND=console
MAIL_FROM=noreply@campfire.local
MAIL_OUTBOX_DIR=tmp/mail
MAIL_HTTP_URL=
MAIL_HTTP_API_KEY=
RATE_LIMIT_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=300
LOG_LEVEL=INFO
ENV=dev
REFRESH_COOKIE_NAME=campfire_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Repertoire slice — Deezer catalog + search cache + rate limiter
DEEZER_BASE_URL=https://api.deezer.com
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_CACHE_MAX_ENTRIES=1024
SEARCH_RATE_LIMIT_PER_WINDOW=30
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# Render production example:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# PYTHON_VERSION=3.12.12
# ENV=prod
# CORS_ORIGINS=https://campfire-web.onrender.com
# GOOGLE_STUB_ENABLED=false
# GOOGLE_OAUTH_ENABLED=true
# GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
# GOOGLE_OAUTH_REDIRECT_URI=https://campfire-api-prod.onrender.com/auth/google/callback
# WEB_BASE_URL=https://campfire-web.onrender.com
# OAUTH_FLOW_HMAC_KEY=<generated-secret>
# EMAIL_CONFIRMATION_HMAC_KEY=<generated-secret>
# MAIL_BACKEND=http
# MAIL_FROM=noreply@campfire.example
# MAIL_HTTP_URL=<provider-endpoint>
# MAIL_HTTP_API_KEY=<provider-api-key>
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none
