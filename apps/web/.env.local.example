# Campfire web local environment
#
# Copy this file to apps/web/.env.local for Vite local development.

# Local API
VITE_API_URL=http://localhost:8000

# Optional fallback for static demo hosts that cannot preserve httpOnly refresh
# cookies. Leave unset for normal local API testing.
# VITE_AUTH_FALLBACK=session-storage

# Render references
#
# Develop:
# VITE_API_URL=https://campfire-api-dev.onrender.com
#
# Production:
# VITE_API_URL=https://campfire-api-prod.onrender.com
